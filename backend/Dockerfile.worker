# syntax=docker/dockerfile:1
# ============================================================================
# Build context: ./backend  (docker-compose.yml → auris-worker.build)
#
# The "base" stage must be IDENTICAL to Dockerfile.api (SCRUM-13): Python 3.11
# slim + SUMO + non-root user. If you change one, update both.
# ============================================================================

# ---------------------------------------------------------------------------
# Shared base: Python + SUMO + non-root user
# ---------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SUMO_HOME=/usr/share/sumo \
    PYTHONPATH=/app

# SUMO: sumo, duarouter, netconvert (sumo package) + randomTrips.py etc. (sumo-tools)
RUN apt-get update \
    && apt-get install -y --no-install-recommends sumo sumo-tools \
    && rm -rf /var/lib/apt/lists/*

# Compose overrides the user with AURIS_UID/AURIS_GID
ARG AURIS_UID=1000
ARG AURIS_GID=1000
RUN groupadd --gid "${AURIS_GID}" auris \
    && useradd --uid "${AURIS_UID}" --gid auris --no-create-home \
       --home-dir /nonexistent --shell /usr/sbin/nologin auris

WORKDIR /app

# ---------------------------------------------------------------------------
# Worker image
# ---------------------------------------------------------------------------
FROM base AS worker

# Dependencies first: when only the code changes, this layer comes from cache.
COPY requirements/base.txt requirements/worker.txt ./requirements/
RUN pip install -r requirements/worker.txt

COPY auris ./auris

USER auris

# Compose already provides this command; keeping it here lets the image run
# on its own as well (docker run auris/worker).
CMD ["celery", "--app=auris.simulation.celery_app", "worker", \
     "--concurrency=1", "--prefetch-multiplier=1", \
     "--queues=simulation", "--loglevel=INFO"]
